{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SecKeyBox",
  "version": "0.3.0",
  "identifier": "com.seckeybox.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png"
    ]
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "SecKeyBox",
        "width": 1200,
        "height": 720,
        "minWidth": 900,
        "minHeight": 550,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "transparent": false,
        "center": true,
        "maximized": false
      },
      {
        "label": "palette",
        "title": "Quick Search",
        "url": "palette.html",
        "width": 560,
        "height": 400,
        "resizable": false,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "center": true,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {}
}