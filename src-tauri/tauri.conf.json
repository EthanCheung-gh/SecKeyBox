{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SecKeyBox",
  "version": "0.6.3",
  "identifier": "com.seckeybox.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build && npm run build:cli"
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "linux": {
      "deb": {
        "files": {
          "/usr/bin/seckeybox-cli": "../cli/target/release/seckeybox-cli"
        }
      }
    },
    "createUpdaterArtifacts": true
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "SecKeyBox",
        "width": 1200,
        "height": 720,
        "minWidth": 900,
        "minHeight": 550,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "transparent": false,
        "center": true,
        "maximized": false
      },
      {
        "label": "palette",
        "title": "Quick Search",
        "url": "palette.html",
        "width": 560,
        "height": 400,
        "resizable": false,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "center": true,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDEwMUM1OTVENDQyMTgwNkYKUldSdmdDRkVYVmtjRU9XUEdDSHF0b1hwR0NOY1JpNXdKV2J2WXRZM1hQa0lUVE81dFltU1lNUTkK",
      "endpoints": [
        "https://github.com/EthanCheung-gh/SecKeyBox/releases/latest/download/latest.json"
      ]
    }
  }
}
